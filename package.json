{
	"name": "@deutschemodelunitednations/munify-brand",
	"version": "0.1.0",
	"description": "The MUNify logo universe (MUNify, CHASE, DELEGATOR): marks, favicons, PWA icons, splash screens and social cards, with Svelte components and a Vite plugin",
	"license": "MIT AND CC-BY-ND-4.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DeutscheModelUnitedNations/munify-brand.git"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"assets",
		"!assets/**/*-hires.png",
		"LICENSE",
		"LICENSE-MARKS.md",
		"GUIDELINES.md"
	],
	"sideEffects": false,
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./dist/vite.js"
		},
		"./assets/*": "./assets/*",
		"./package.json": "./package.json"
	},
	"scripts": {
		"generate": "bun scripts/generate.ts",
		"build": "svelte-package -i src/lib -o dist && find dist -name '*.test.*' -delete",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"peerDependencies": {
		"svelte": "^5.50.0",
		"vite": ">=6.0.0"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@fontsource/outfit": "^5.3.0",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/package": "^3.0.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.6.6",
		"@types/opentype.js": "^1.3.10",
		"jsdom": "^31.0.1",
		"opentype.js": "^2.0.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"typescript": "^6",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	}
}
